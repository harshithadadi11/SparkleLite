rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Health records: users/{userId}/records/{filename}
    match /users/{userId}/records/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024  // 10MB max
        && request.resource.contentType.matches('application/pdf|image/.*|text/plain');
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false; // Files are immutable; delete and re-upload
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
